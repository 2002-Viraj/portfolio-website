/* =========================================
   PREMIUM PROJECT GALLERY SECTION
========================================= */

#projects{
    position: relative;
    overflow: hidden;
}

/* Background Glow */

#projects::before{
    content: "";
    position: absolute;
    width: 500px;
    height: 500px;
    background: rgba(59,130,246,0.10);
    filter: blur(120px);
    top: -150px;
    left: -150px;
    z-index: 0;
}

#projects::after{
    content: "";
    position: absolute;
    width: 450px;
    height: 450px;
    background: rgba(168,85,247,0.10);
    filter: blur(120px);
    bottom: -180px;
    right: -120px;
    z-index: 0;
}

/* Project Grid */

.project-grid{
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(340px,1fr));
    gap: 35px;
    margin-top: 60px;
}

/* Project Card */

.project-card{
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    background: rgba(10,15,35,0.82);
    border: 1px solid rgba(255,255,255,0.08);
    backdrop-filter: blur(18px);
    transition: all 0.45s ease;
    box-shadow:
        0 10px 40px rgba(0,0,0,0.35);
}

.project-card:hover{
    transform: translateY(-14px) scale(1.02);
    border-color: rgba(56,189,248,0.45);
    box-shadow:
        0 20px 70px rgba(0,0,0,0.45),
        0 0 25px rgba(56,189,248,0.15);
}

/* Project Image */

.project-image{
    position: relative;
    overflow: hidden;
    height: 240px;
}

.project-image img{
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
}

/* Zoom Effect */

.project-card:hover .project-image img{
    transform: scale(1.12);
}

/* Dark Overlay */

.project-image::before{
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to top,
        rgba(0,0,0,0.85),
        rgba(0,0,0,0.10)
    );
    z-index: 1;
}

/* Floating Label */

.project-label{
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    background: rgba(56,189,248,0.15);
    border: 1px solid rgba(56,189,248,0.35);
    color: #38bdf8;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    backdrop-filter: blur(10px);
}

/* Project Content */

.project-content{
    padding: 28px;
}

.project-content h3{
    font-size: 28px;
    color: white;
    margin-bottom: 14px;
    font-weight: 800;
    line-height: 1.2;
}

.project-content p{
    color: #94a3b8;
    line-height: 1.8;
    font-size: 15px;
    margin-bottom: 24px;
}

/* Technology Tags */

.project-tech{
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 28px;
}

.project-tech span{
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(56,189,248,0.18);
    color: #dbeafe;
    font-size: 13px;
    font-weight: 700;
    transition: all 0.35s ease;
}

.project-tech span:hover{
    transform: translateY(-4px);
    background: rgba(56,189,248,0.15);
    border-color: rgba(56,189,248,0.45);
}

/* Buttons */

.project-buttons{
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.project-btn{
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 14px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.35s ease;
}

/* View Project */

.project-btn.primary{
    background: linear-gradient(
        90deg,
        #2563eb,
        #7c3aed
    );
    color: white;
    box-shadow:
        0 10px 20px rgba(37,99,235,0.25);
}

.project-btn.primary:hover{
    transform: translateY(-4px);
    box-shadow:
        0 16px 30px rgba(37,99,235,0.35);
}

/* GitHub Button */

.project-btn.secondary{
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.04);
    color: #dbeafe;
}

.project-btn.secondary:hover{
    background: rgba(56,189,248,0.12);
    border-color: rgba(56,189,248,0.35);
    transform: translateY(-4px);
}

/* Project Title */

.projects-title{
    text-align: center;
    margin-bottom: 50px;
}

.projects-title h2{
    font-size: clamp(48px,6vw,72px);
    font-weight: 900;
    background: linear-gradient(
        90deg,
        #ffffff,
        #c4b5fd,
        #38bdf8
    );
    -webkit-background-clip: text;
    color: transparent;
}

.projects-title p{
    color: #94a3b8;
    margin-top: 12px;
    font-size: 18px;
}

/* Responsive */

@media(max-width:768px){

    .project-grid{
        grid-template-columns: 1fr;
    }

    .project-content h3{
        font-size: 24px;
    }

    .project-image{
        height: 220px;
    }

    .project-buttons{
        flex-direction: column;
    }

    .project-btn{
        justify-content: center;
    }
}